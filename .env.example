# ============================================================
# InterviewPrep 环境变量配置
# 复制此文件为 .env 并填入实际值
# 生产环境（Render）请在 Dashboard 中设置这些环境变量
# ============================================================

# ============================================================
# 其他可选配置
# ============================================================

# 服务端口（默认 3456）
PORT=3456

# 数据目录
DATA_DIR=.

# 监听地址：默认 127.0.0.1（仅本机可访问）。Render 会自动使用 0.0.0.0；
# 其他云平台需手动设为 0.0.0.0，并在反向代理层做访问控制。
# HOST=0.0.0.0

# 跳过网关（云端部署设 1）
NO_GATEWAY=1